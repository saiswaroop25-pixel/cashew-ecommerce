# Copy to .env.local and fill in. Never commit real values.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Your Cashew Brand (placeholder)"

# --- Business contact (configurable; do not hardcode) ---
NEXT_PUBLIC_WHATSAPP_NUMBER=            # digits only with country code, e.g. 919XXXXXXXXX
NEXT_PUBLIC_CONTACT_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=              # server only, never expose

# --- Database (Supabase Postgres) ---
DATABASE_URL=                           # pooled connection (runtime)
DIRECT_URL=                             # direct connection (migrations)

# --- Razorpay (use TEST keys until go-live) ---
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=                    # server only
RAZORPAY_WEBHOOK_SECRET=                # server only

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="Brand <orders@example.com>"

# --- Shipping (optional until configured) ---
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
DELHIVERY_API_TOKEN=

# --- Scheduled jobs (>=16 chars; sent as Authorization: Bearer) ---
CRON_SECRET=

# --- Rate limiting (optional extra salt for hashed keys) ---
RATE_LIMIT_SALT=
